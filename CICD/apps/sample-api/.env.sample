# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devflow

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=devflow-ai-jwt-secret-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Security ──────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── CORS ──────────────────────────────────────────────────────────────────────
# In production, set this to your actual frontend domain(s), comma-separated.
# Example: https://devflow.example.com,https://www.devflow.example.com
CORS_ORIGIN=http://localhost:5173

# ─── GitHub Webhook Secret ─────────────────────────────────────────────────────
# The secret used when creating GitHub webhooks. MUST match the secret configured
# on the GitHub webhook. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# ─── Redis / BullMQ ───────────────────────────────────────────────────────────
# Standard Redis URL. For local docker-compose, leave unset (defaults to 127.0.0.1:16379).
# For production (Render, Railway, etc.): redis://user:password@host:port
# REDIS_URL=redis://localhost:6379
