{
  "name": "user-web",
  "version": "4.35.2",
  "private": true,
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:cache": "eslint . --cache",
    "lint-scss": "stylelint '**/*.scss'",
    "lint-scss:cache": "stylelint '**/*.scss' --cache",
    "dev": "export NODE_ENV=development export NEXT_PUBLIC_MODE=DEV && node server/index.js",
    "dev:test": "NODE_ENV=development export NEXT_PUBLIC_MODE=TEST && node server/index.js",
    "start": "NODE_ENV=production && node server/index.js",
    "export": "next export",
    "generate-sitemap": "export NEXT_PUBLIC_APP_DOMAIN='https://web.aurahealth.io' && export NEXT_PUBLIC_MODE=PROD && node scripts/createSitemap.js",
    "heroku-cleanup": "rm -rf .next/cache && find node_modules/@next -depth -maxdepth 1 -type d -name 'swc*' -exec rm -rf {} \\; -prune #Remove cache and SWC binaries to reduce heroku slug size: https://github.com/vercel/next.js/issues/32183#issuecomment-988742663",
    "heroku-postbuild": "npm run build:dev",
    "build": "npm run generate-sitemap && export NEXT_PUBLIC_MODE=PROD && next build --webpack",
    "build:dev": "NODE_ENV=production export NEXT_PUBLIC_MODE=DEV && next build --webpack",
    "build:test": "NEXT_PUBLIC_MODE=TEST NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000 next build --webpack",
    "serve": "NODE_ENV=production export NEXT_PUBLIC_MODE=PROD && node server/index.js",
    "serve:dev": "NODE_ENV=production export NEXT_PUBLIC_MODE=DEV && node server/index.js",
    "serve:test": "NEXT_PUBLIC_MODE=TEST NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000 NODE_ENV=production node server/index.js",
    "release": "npx release-it",
    "test": "jest",
    "test:e2e": "NODE_ENV=production playwright test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@aurahealth/web-design-system": "0.0.76",
    "@bugsnag/js": "8.10.0",
    "@bugsnag/plugin-react": "8.9.0",
    "@next/env": "16.2.10",
    "@react-oauth/google": "0.13.5",
    "@reduxjs/toolkit": "2.12.0",
    "@stripe/react-stripe-js": "6.8.0",
    "@stripe/stripe-js": "9.12.0",
    "@svgr/webpack": "8.1.0",
    "@vercel/og": "0.11.1",
    "axios": "1.18.1",
    "base-x": "5.0.1",
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "express": "5.2.1",
    "express-sslify": "1.2.0",
    "firebase": "12.16.0",
    "glob": "13.0.6",
    "http-proxy-middleware": "4.2.0",
    "human-readable-numbers": "0.9.5",
    "i18next": "26.3.6",
    "mixpanel-browser": "2.81.0",
    "next": "16.2.10",
    "next-i18next": "16.0.8",
    "next-redux-wrapper": "8.1.0",
    "node-cache": "5.1.2",
    "node-match-path": "0.6.3",
    "qrcode.react": "4.2.0",
    "react": "19.2.7",
    "react-confetti": "6.4.0",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.10",
    "react-icons": "5.7.0",
    "react-phone-number-input": "3.4.17",
    "react-redux": "9.3.0",
    "react-responsive-carousel": "3.2.23",
    "react-toastify": "11.1.0",
    "react-video-seek-slider": "8.0.4",
    "request-ip": "3.3.0",
    "sass": "1.101.3",
    "sharp": "0.35.3",
    "shuffle-array": "1.0.1",
    "validator": "13.15.35",
    "webpack-bugsnag-plugins": "2.2.3",
    "xmlbuilder2": "4.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "eslint": "9.39.5",
    "eslint-config-airbnb-extended": "3.1.1",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-jest": "29.15.5",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-junit": "17.0.0",
    "next-router-mock": "1.0.5",
    "prettier": "3.9.6",
    "release-it": "20.2.1",
    "styled-jsx": "5.1.7",
    "stylelint": "17.14.1",
    "stylelint-config-sass-guidelines": "13.0.0"
  },
  "proxy": {
    "/auraServices": {
      "target": "https://localhost:4000",
      "changeOrigin": true,
      "pathRewrite": {
        "^/auraServices": "/"
      }
    }
  },
  "description": "[![CircleCI](https://circleci.com/gh/AuraHealth/UserWeb.svg?style=svg)](https://circleci.com/gh/AuraHealth/UserWeb) [![code style: prettier](https://img.shields.io/badge/code_style-prettier-ff69b4.svg?style=flat-square)](https://github.com/prettier/prettier)",
  "main": "next.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AuraHealth/UserWeb.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AuraHealth/UserWeb/issues"
  },
  "homepage": "https://github.com/AuraHealth/UserWeb#readme"
}
