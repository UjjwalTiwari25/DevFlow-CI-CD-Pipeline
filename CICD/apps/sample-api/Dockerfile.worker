# ─── Worker Dockerfile ─────────────────────────────────────────────────────────
# Runs the BullMQ pipeline worker as a separate process.
# This is deployed alongside the API as a background worker service.
# ───────────────────────────────────────────────────────────────────────────────

FROM node:22-alpine AS builder
WORKDIR /app

# Copy dependency manifests first for better layer caching
COPY package*.json ./
RUN npm install --ignore-scripts

# Copy Prisma schema and generate client
COPY prisma ./prisma
RUN npx prisma generate

# Copy application source
COPY . .

# ─── Production Stage ──────────────────────────────────────────────────────────

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Install git
RUN apk add --no-cache git

# Copy built artifacts from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/src ./src
COPY --from=builder /app/prisma ./prisma

# Create non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

# Worker doesn't expose any ports — it pulls jobs from Redis

CMD ["node", "src/workers/pipelineWorker.js"]
